{
  "name": "repoprep-mcp",
  "version": "0.1.0",
  "description": "Local-first MCP server for repoprep — turn a codebase into AI-ready context, directly inside Claude. No upload, same engine as repoprep.com.",
  "type": "module",
  "bin": {
    "repoprep-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-context",
    "codebase",
    "repoprep"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kishoren1/repoprep-mcp.git"
  },
  "homepage": "https://www.repoprep.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "shx": "^0.4.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
